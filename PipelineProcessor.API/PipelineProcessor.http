@PipelineProcessor_HostAddress = http://localhost:5162
@PipelineId = replace-with-pipeline-id
@RunId = replace-with-run-id

### Register a pipeline (body from tools/sample-data/pipeline.json)
POST {{PipelineProcessor_HostAddress}}/pipelines
Content-Type: application/json

{
  "name": "Demo Line 20in",
  "outerDiameterMm": 508.0,
  "wallThicknessMm": 8.7,
  "grade": "X52",
  "smysMpa": 359.0,
  "maopMpa": 7.0,
  "route": {
    "type": "LineString",
    "coordinates": [
      [101.6869, 3.139],
      [101.8, 3.21],
      [101.9, 3.35],
      [102.05, 3.42]
    ]
  }
}

###

GET {{PipelineProcessor_HostAddress}}/pipelines/{{PipelineId}}
Accept: application/json

###

### Upload an ILI run
POST {{PipelineProcessor_HostAddress}}/pipelines/{{PipelineId}}/runs
Content-Type: multipart/form-data; boundary=RunBoundary

--RunBoundary
Content-Disposition: form-data; name="inspectionDate"

2020-03-01
--RunBoundary
Content-Disposition: form-data; name="file"; filename="ili_run_1.xlsx"
Content-Type: application/vnd.openxmlformats-officedocument.spreadsheetml.sheet

< ../../tools/sample-data/ili_run_1.xlsx
--RunBoundary--

###

GET {{PipelineProcessor_HostAddress}}/runs/{{RunId}}/status
Accept: application/json

###

GET {{PipelineProcessor_HostAddress}}/pipelines/{{PipelineId}}/anomalies?minErf=1&fromM=0&toM=5000&page=1&pageSize=100
Accept: application/json

###

GET {{PipelineProcessor_HostAddress}}/pipelines/{{PipelineId}}/anomalies.geojson?bbox=101.6,3.1,102.1,3.5
Accept: application/geo+json

###

GET {{PipelineProcessor_HostAddress}}/pipelines/{{PipelineId}}/digs
Accept: application/json
